{
	"manifest_version": 3,
	"name": "搜索推荐词采集与AI分析助手",
	"version": "1.2",
	"description": "提取小红书、抖音、B站、知乎、百度、google搜索推荐词，并用 Claude / OpenAI 分析采集到的关键词",
	"author": "niemingxing",
	"icons":
	{
		"16":"icon16.png",
		"48":"icon48.png",
		"128":"icon128.png"
	},
	"action":
	{
		"default_icon": "icon16.png",
		"default_popup": "popup.html"
	},
	"options_page": "options.html",
	"side_panel":
	{
		"default_path": "sidepanel.html"
	},
	"host_permissions": [
		"https://api.anthropic.com/*",
		"https://api.openai.com/*",
		"https://openrouter.ai/*"
	],
	"content_scripts":
	[
		{
			"matches": ["https://www.xiaohongshu.com/*","https://www.douyin.com/*","https://www.bilibili.com/*","https://www.zhihu.com/*","https://www.baidu.com/*","https://www.google.com/*"],
			"js": ["js/jquery.min.js","js/content-script.js"]
		}
	],
	"permissions": [
		"storage",
		"activeTab",
		"tabs",
		"sidePanel"
	]
}
